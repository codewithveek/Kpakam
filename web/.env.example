# Copy to web/.env.local and fill in from Firebase console > Project settings > Your apps (Web).
# Firebase web config is public by design; App Check protects the backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check: reCAPTCHA Enterprise site key (Security > App Check > Apps).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional, dev only: a registered App Check debug token. Leave empty to auto-generate one
# (it prints in the browser console). NEVER commit a real token.
VITE_APPCHECK_DEBUG_TOKEN=

# Local development against emulators, with a scripted model (no Firebase project needed).
VITE_USE_EMULATORS=false
VITE_FAKE_INFERENCE=false
